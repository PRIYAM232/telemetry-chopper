# Copy to deploy/datadog/.env (git-ignored) and fill in.
# API key: Datadog → Organization Settings → API Keys.
DD_API_KEY=
# Your Datadog site: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com,
# datadoghq.eu, ap1.datadoghq.com ...
DD_SITE=datadoghq.com
# Optional: an application key lets `run.sh check <run-id>` count results
# through the Datadog API. Without it, check in the Datadog UI instead.
DD_APP_KEY=

{
  "__inputs": [],
  "annotations": { "list": [] },
  "description": "Self-monitoring for the Telemetry Chopper observability proxy: otelcol-chopper process health, synced ruleset size, and per-signal throughput/drops from the chopper_filter engine. Metric names assume the chart's telemetry reader config (classic collector names, no _total/unit suffixes).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Collector process",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "CPU consumed by each collector pod. otelcol_process_cpu_seconds is cumulative; the rate is cores in use.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "none",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(otelcol_process_cpu_seconds{pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "CPU usage (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Resident set size per collector pod. Compare against the collector container's memory limit.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "otelcol_process_memory_rss{pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Memory RSS",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": [],
      "title": "Telemetry Chopper engine",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rules in the currently synced chopper_filter ruleset. 0 with traffic flowing means the collector cannot reach the control plane (or the fleet has no enabled rules).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(otelcol_chopper_filter_rules{pod=~\"$pod\"})",
          "legendFormat": "rules",
          "refId": "A"
        }
      ],
      "title": "Active rules synced",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Share of incoming telemetry (spans + log records + metrics) removed by chopper_filter rules — the proxy's cost-savings knob, and the number to watch after a rule change.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * (sum(rate(otelcol_chopper_filter_spans_dropped{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_chopper_filter_logs_dropped{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_chopper_filter_metrics_dropped{pod=~\"$pod\"}[$__rate_interval]))) / (sum(rate(otelcol_chopper_filter_spans_received{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_chopper_filter_logs_received{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_chopper_filter_metrics_received{pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "dropped",
          "refId": "A"
        }
      ],
      "title": "Drop ratio (all signals)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry entering chopper_filter across all collector pods, per signal.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_chopper_filter_spans_received{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_chopper_filter_logs_received{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_chopper_filter_metrics_received{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metrics",
          "refId": "C"
        }
      ],
      "title": "Received /s (by signal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry removed by chopper_filter rules (DROP, SAMPLE, THROTTLE), per signal.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_chopper_filter_spans_dropped{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_chopper_filter_logs_dropped{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_chopper_filter_metrics_dropped{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metrics",
          "refId": "C"
        }
      ],
      "title": "Dropped by rules /s (by signal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry the OTLP receiver refused (backpressure / bad payloads). Non-zero here means producers are losing data BEFORE chopper_filter ever sees it.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_receiver_refused_spans{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_receiver_refused_log_records{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_receiver_refused_metric_points{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metric points",
          "refId": "C"
        }
      ],
      "title": "OTLP receiver refusals /s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry removed per chopper_filter rule (top 10 by rate): which rule is doing the work. Summed across pods; a THROTTLE rule only shows its excess over the limit.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 26 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk(10, sum by (rule_name, signal, action) (rate(otelcol_chopper_filter_rule_dropped{pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{rule_name}} ({{action}} {{signal}})",
          "refId": "A"
        }
      ],
      "title": "Dropped by rule /s (top 10)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Enforced rules whose condition matched nothing in the last hour across all pods. Usually a typo in the condition field or value, or a source that stopped sending. Rules for a signal with no traffic count too; paused and not-enforced rules don't.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 26 },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count((sum by (rule_id) (increase(otelcol_chopper_filter_rule_matched{pod=~\"$pod\"}[1h])) == 0) and on (rule_id) max by (rule_id) (otelcol_chopper_filter_rule_status{pod=~\"$pod\", state=\"enforced\"})) or vector(0)",
          "legendFormat": "rules",
          "refId": "A"
        }
      ],
      "title": "Rules matching nothing (1h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Active rules the collector cannot enforce: invalid (bad regex, or a SAMPLE / ROUTE / THROTTLE rule missing its parameter) or unsupported (action not implemented for the signal). Paused rules are not counted. Alert on this being non-zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 34 },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(max by (rule_id) (otelcol_chopper_filter_rule_status{pod=~\"$pod\", state=~\"invalid|unsupported\"})) or vector(0)",
          "legendFormat": "rules",
          "refId": "A"
        }
      ],
      "title": "Rules not enforced",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Every active rule the collector is not enforcing, and why. Fix invalid rules in the dashboard; unsupported ones need a different action or signal (or a newer collector).",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 34 },
      "id": 11,
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (rule_name, rule_id, signal, action, state, reason) (otelcol_chopper_filter_rule_status{pod=~\"$pod\", state=~\"invalid|unsupported\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true },
            "indexByName": { "rule_name": 0, "signal": 1, "action": 2, "state": 3, "reason": 4, "rule_id": 5 }
          }
        }
      ],
      "title": "Rules not enforced",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["chopper", "opentelemetry", "self-monitoring"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "pod",
        "label": "Collector pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(otelcol_process_uptime, pod)",
        "current": {},
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Telemetry Chopper — Collector Self-Monitoring",
  "uid": "chopper-collector-health",
  "version": 1
}

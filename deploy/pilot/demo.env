# Layered over the demo's own .env. Pins the demo's images to the same
# release as its source (scripts/up.sh clones that tag), instead of "latest".
DEMO_VERSION=3.1.0
# Locust users the demo's load generator starts with. Raise for a heavier
# rehearsal (the load generator UI can change it live, too).
LOCUST_USERS=10

# Shop / proxy port. 8080 is often taken on developer machines. Variables the
# demo derives from ENVOY_PORT are restated, because the demo's .env expands
# them before this file is read.
ENVOY_PORT=8180
FRONTEND_PROXY_ADDR=frontend-proxy:8180
LOCUST_HOST=http://frontend-proxy:8180
PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:8180/otlp-http/v1/traces

{
  "title": "Telemetry Chopper \u2014 Pilot overview",
  "uid": "chopper-pilot-overview",
  "tags": [
    "chopper",
    "pilot"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "Volume reduction",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Spans dropped",
      "description": "Share of spans entering the gateways that Telemetry Chopper rules removed (5m).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * sum(rate(otelcol_chopper_filter_spans_dropped[5m])) / clamp_min(sum(rate(otelcol_chopper_filter_spans_received[5m])), 1e-9)"
        }
      ]
    },
